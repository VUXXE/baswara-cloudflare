# Local dev vars (used by vite + wrangler dev as .dev.vars).
# NEVER commit real values — .env is git-ignored.
# Production values live in Cloudflare dashboard / `wrangler secret`.

BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
R2_PUBLIC_URL="https://<bucket-public-domain>"
